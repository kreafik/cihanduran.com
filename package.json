{
  "name": "cihanduran-com",
  "private": true,
  "type": "module",
  "description": "cihanduran.com — Astro statik site, Cloudflare Workers (static assets + Worker) üzerinde.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test tests/",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "versions:upload": "npm run build && wrangler versions upload",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@radix-ui/react-menubar": "^1.1.6",
    "astro": "^7.4.13",
    "color": "^4.2.3",
    "dompurify": "^3.2.4",
    "framer-motion": "^12.0.0",
    "hack-font": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "sharp": "^0.35.5",
    "simplebar-react": "^3.2.4",
    "styled-components": "^6.1.14"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true
  }
}
