---
import { getCollection } from 'astro:content';
import Desktop from '../../layouts/Desktop.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { t } from '../../i18n';

const work = (await getCollection('isler')).sort((a, b) => a.data.order - b.data.order);
const filters = [
  { id: 'tumu', label: 'Tümü' },
  { id: 'yazilim', label: 'Yazılım' },
  { id: 'drone', label: 'Drone' },
  { id: 'fotograf', label: 'Fotoğraf' },
] as const;
const counts = Object.fromEntries(filters.map((f) => [f.id, f.id === 'tumu' ? work.length : work.filter((w) => w.data.category.includes(f.id as any)).length]));
---
<Desktop
  title="İşler | Cihan Duran"
  description={`Bodrum'da ve Türkiye'de işletmeler için yaptığım ${work.length} web sitesi; oteller, gulet kiralama, hukuk, inşaat ve daha fazlası. Hepsi yayında.`}
  path="/isler"
>
  <header class="container head">
    <Breadcrumb items={[{ name: t('nav.home'), path: '/' }, { name: t('nav.work') }]} />
    <h1>İşler</h1>
    <p class="lead">{work.length} işletmenin sitesi şu an yayında. Her birine tıklayıp ne yaptığımı okuyabilir, siteyi açıp kendiniz gezebilirsiniz.</p>
  </header>

  <div class="container">
    <form class="filters" aria-label="Kategoriye göre süz">
      {filters.map((f, i) => (
        <label>
          <input type="radio" name="kategori" value={f.id} checked={i === 0} disabled={counts[f.id] === 0} />
          <span>{f.label} <small>{counts[f.id]}</small></span>
        </label>
      ))}
    </form>

    <ul class="grid">
      {work.map((w, i) => (
        <li data-cat={w.data.category.join(' ')}><ProjectCard entry={w} headingLevel="h2" eager={i < 3} /></li>
      ))}
    </ul>
  </div>

  <QuoteCta title="Sıradaki site sizinki olsun." message="Merhaba Cihan, web sitesi için görüşmek istiyorum." />
</Desktop>

<style>
  .head { padding-top: clamp(2rem, 1.5rem + 3vw, 4rem); }
  .head h1 { margin-top: 1.25rem; }
  .lead { margin-top: 1rem; max-width: 56ch; font-size: var(--fs-md); color: rgb(245 245 247 / 0.82); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 2.5rem 0 2rem; }
  .filters input { position: absolute; opacity: 0; pointer-events: none; }
  .filters span {
    display: inline-flex; align-items: center; gap: 0.4rem;
    min-height: 40px; padding: 0.45rem 1rem;
    border-radius: var(--r-pill);
    background: var(--c-surface);
    font-size: var(--fs-sm); font-weight: 600; cursor: pointer;
  }
  .filters small { color: var(--c-muted); font-weight: 500; }
  .filters input:checked + span { background: var(--c-text); color: var(--c-bg); }
  .filters input:checked + span small { color: rgb(28 28 30 / 0.6); }
  .filters input:focus-visible + span { outline: 2px solid var(--c-accent); outline-offset: 2px; }
  .filters input:disabled + span { opacity: 0.4; cursor: not-allowed; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 3rem 2rem;
    list-style: none;
    padding: 0;
  }

  /* JS'siz süzme: seçili kategoriye uymayan kartları gizle */
  .container:has(input[value='yazilim']:checked) li:not([data-cat~='yazilim']),
  .container:has(input[value='drone']:checked) li:not([data-cat~='drone']),
  .container:has(input[value='fotograf']:checked) li:not([data-cat~='fotograf']) { display: none; }
</style>
