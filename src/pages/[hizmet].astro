---
// Üç hizmet sayfası (ana sayfa dili): /drone-cekimi-bodrum, /fotograf-video-cekimi-bodrum, /yapay-zeka-yazilim
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Desktop from '../layouts/Desktop.astro';
import MediaCinema, { type CinemaMedia } from '../components/MediaCinema.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BigStats from '../components/service/BigStats.astro';
import ScopeCards from '../components/service/ScopeCards.astro';
import CategoryTiles from '../components/service/CategoryTiles.astro';
import WorkWall from '../components/home/WorkWall.astro';
import TechMarquee from '../components/home/TechMarquee.astro';
import WorkCard from '../components/WorkCard.astro';
import Faq from '../components/Faq.astro';
import QuoteCta from '../components/QuoteCta.astro';
import Icon from '../components/Icon.astro';
import { getAllWork } from '../lib/work';
import { media, shoots } from '../lib/media';
import { buildServiceSchema } from '../lib/schema.mjs';
import { site, whatsappLink } from '../site.config.mjs';
import { t } from '../i18n';

export async function getStaticPaths() {
  const services = await getCollection('hizmetler');
  return services.map((entry) => ({ params: { hizmet: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'hizmetler'> }
const { entry } = Astro.props;
const d = entry.data;
const path = `/${entry.id}`;
const { Content } = await render(entry);
const kind = d.workCategory;
const isSoftware = kind === 'yazilim';

// Hero medyası: drone → Bodrum videosu; fotoğraf → seçilen çekimin kapağı.
const v = site.heroVideo;
const heroShoot = d.heroShoot ? shoots.find((s) => s.slug === d.heroShoot) : undefined;
const heroMedia: CinemaMedia | undefined =
  kind === 'drone' && v.mp4
    ? { type: 'video', src: v.mp4, webm: v.webm, poster: v.poster, label: "Bodrum'un drone ile havadan görüntüsü" }
    : heroShoot?.photos[0]
      ? { type: 'image', src: media.photoSrc(heroShoot, heroShoot.photos[0], 1600), srcset: media.photoSrcset(heroShoot, heroShoot.photos[0]),
          alt: `${heroShoot.project} çekiminden`, width: heroShoot.photos[0].w, height: heroShoot.photos[0].h }
      : undefined;

// İlgili işler
const all = await getAllWork();
const work = isSoftware
  ? all.filter((w) => w.site).slice(0, 8)
  : kind === 'drone'
    ? all.filter((w) => w.shoot?.videos.length).slice(0, 8)
    : [...new Map(all.filter((w) => w.shoot?.photos.length).map((w) => [w.groups[0].slug, w])).values()]
        .concat(all.filter((w) => w.shoot?.photos.length))
        .filter((w, i, arr) => arr.findIndex((x) => x.slug === w.slug) === i)
        .slice(0, 8);
const workTitle = isSoftware ? 'Yaptığım siteler' : kind === 'drone' ? 'Videolu çekimler' : 'Son çekimler';
const others = (await getCollection('hizmetler')).filter((s) => s.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
---
<Desktop title={d.seoTitle} description={d.description} path={path} jsonLd={buildServiceSchema(entry)}>
  {heroMedia ? (
    <MediaCinema media={heroMedia} first words={kind === 'drone' ? ['Havadan.', 'Bodrum.'] : undefined}>
      <div slot="intro" class="intro">
        <Breadcrumb items={[{ name: t('nav.home'), path: '/' }, { name: d.name }]} />
        <h1>{d.title}</h1>
      </div>
      <div slot="caption" class="caption">
        <p class="cap-text">{d.lead}</p>
        <div class="actions">
          <a class="btn btn-whatsapp" href={whatsappLink(d.whatsappMessage)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Teklif alın</a>
          <a class="btn btn-ghost" href="#isler">{workTitle}</a>
        </div>
      </div>
    </MediaCinema>
  ) : (
    <section class="ahero" aria-labelledby="hizmet-baslik">
      <div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="container">
        <Breadcrumb items={[{ name: t('nav.home'), path: '/' }, { name: d.name }]} />
        <h1 id="hizmet-baslik">{d.title}</h1>
        <p class="lead">{d.lead}</p>
        <div class="actions">
          <a class="btn btn-whatsapp" href={whatsappLink(d.whatsappMessage)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Teklif alın</a>
          <a class="btn btn-ghost" href="#isler">{workTitle}</a>
        </div>
      </div>
    </section>
  )}

  {isSoftware && <WorkWall />}

  <BigStats items={d.proof} />

  <ScopeCards title={isSoftware ? 'Neler yapıyorum' : 'Neler çekiyorum'} items={d.scope} />

  {isSoftware ? <TechMarquee /> : <CategoryTiles />}

  <section class="section container" id="isler" aria-labelledby="isler-baslik">
    <div class="section-head">
      <h2 id="isler-baslik">{workTitle}</h2>
      <p>{isSoftware ? 'Hepsi şu an yayında; tıklayıp ne yaptığımı okuyabilirsiniz.' : 'Tıklayın, çekimin tamamını ve videolarını görün.'}</p>
    </div>
    <ul class="work-grid">
      {work.map((w) => <li><WorkCard work={w} /></li>)}
    </ul>
    <p class="more"><a class="btn btn-ghost" href={isSoftware ? '/isler#yazilim' : '/isler'}>Tüm işler</a></p>
  </section>

  <section class="section container" aria-labelledby="surec">
    <h2 id="surec">Nasıl çalışıyorum</h2>
    <ol class="process">
      {d.process.map((p) => (
        <li>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  {entry.body?.trim() && (
    <section class="section container"><div class="prose"><Content /></div></section>
  )}

  <section class="section container"><Faq items={d.faq} /></section>

  <section class="section container" aria-labelledby="diger">
    <h2 id="diger">Diğer hizmetler</h2>
    <ul class="others">
      {others.map((s) => (
        <li><a href={`/${s.id}`}><strong>{s.data.name}</strong><span>{s.data.tagline}</span></a></li>
      ))}
    </ul>
  </section>

  <QuoteCta title={`${d.name} için teklif alın`} message={d.whatsappMessage} />
</Desktop>

<style>
  .intro h1 { margin-top: 0.9rem; font-size: clamp(2rem, 1.1rem + 3vw, 3.8rem); letter-spacing: -0.04em; line-height: 1; max-width: 24ch; }
  .caption { max-width: 60ch; }
  .cap-text { font-size: var(--fs-md); line-height: 1.5; color: rgb(245 245 247 / 0.92); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }

  .ahero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(2.5rem, 2rem + 4vw, 6rem) 0 clamp(2rem, 1rem + 3vw, 4rem); background: #07070a; }
  .ahero::after { content: ''; position: absolute; inset: auto 0 0; height: 40%; z-index: -1; background: linear-gradient(transparent, var(--c-bg)); }
  .aurora { position: absolute; inset: -20%; z-index: -2; filter: blur(60px); }
  .aurora i { position: absolute; border-radius: 50%; opacity: 0.55; animation: drift 24s ease-in-out infinite alternate; }
  .aurora i:nth-child(1) { width: 55%; height: 60%; right: 5%; top: 5%; background: radial-gradient(closest-side, rgb(64 120 255 / 0.75), transparent); }
  .aurora i:nth-child(2) { width: 45%; height: 50%; left: 40%; top: 35%; background: radial-gradient(closest-side, rgb(170 90 255 / 0.6), transparent); animation-duration: 30s; }
  .aurora i:nth-child(3) { width: 40%; height: 45%; left: 0; bottom: 5%; background: radial-gradient(closest-side, rgb(40 200 120 / 0.28), transparent); animation-duration: 36s; }
  @keyframes drift { to { transform: translate3d(6%, -4%, 0) scale(1.15); } }
  .ahero h1 { margin-top: 1.25rem; font-size: clamp(2.6rem, 1.2rem + 5.4vw, 6.4rem); font-weight: 800; line-height: 0.95; letter-spacing: -0.05em; max-width: 15ch; }
  .lead { margin-top: 1.4rem; max-width: 56ch; font-size: var(--fs-md); line-height: 1.5; color: rgb(245 245 247 / 0.8); }

  .work-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 2.25rem 1.25rem; list-style: none; padding: 0; }
  .more { margin-top: 2.25rem; }

  .process { counter-reset: step; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 2rem; margin-top: 1.75rem; list-style: none; padding: 0; }
  .process li { counter-increment: step; }
  .process li::before { content: counter(step); display: grid; place-items: center; width: 2rem; height: 2rem; margin-bottom: 0.9rem; border-radius: 50%; background: var(--c-surface-2); font-weight: 700; font-size: var(--fs-sm); }
  .process p { margin-top: 0.4rem; color: rgb(245 245 247 / 0.78); max-width: 52ch; }

  .others { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; margin-top: 1.5rem; list-style: none; padding: 0; }
  .others a { display: flex; flex-direction: column; gap: 0.2rem; padding: 1.1rem 1.25rem; border-radius: var(--r-window); background: var(--c-surface); color: var(--c-text); text-decoration: none; }
  .others a:hover strong { color: var(--c-accent-text); }
  .others span { color: var(--c-muted); font-size: var(--fs-sm); }
  @media (prefers-reduced-motion: reduce) { .aurora i { animation: none; } }
</style>
