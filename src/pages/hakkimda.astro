---
import { buildPageSchema } from '../lib/schema.mjs';
import { getCollection } from 'astro:content';
import Desktop from '../layouts/Desktop.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Placeholder from '../components/Placeholder.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { site } from '../site.config.mjs';
import { t } from '../i18n';

const services = (await getCollection('hizmetler')).sort((a, b) => a.data.order - b.data.order);
---
<Desktop
  title="Hakkımda | Cihan Duran, Bodrum"
  description="Cihan Duran: Bodrum merkezli drone, fotoğraf ve video prodüksiyonu ile yapay zeka destekli web sitesi ve yazılım geliştirme."
  path="/hakkimda"
  jsonLd={buildPageSchema('ProfilePage', 'Hakkımda', '/hakkimda')}
>
  <div class="container wrap">
    <header class="head">
      <Breadcrumb items={[{ name: t('nav.home'), path: '/' }, { name: t('nav.about') }]} />
      <h1>Cihan Duran</h1>
      <p class="lead">
        Bodrum merkezli olarak {site.stats.years} yıldır fotoğraf ve video prodüksiyonu ile yazılım geliştirme alanlarında çalışıyorum. Bugüne kadar {site.stats.software} yazılım projesi ve {site.stats.shoots} fotoğraf ve video çekimi teslim ettim.
      </p>
    </header>
    <div class="portrait">
      <Placeholder label="Cihan'ın portresi — doğal ışık, dikey" ratio="4 / 5" />
    </div>

    <div class="prose story">
      <h2>Uzmanlık alanları</h2>
      <p>
        <strong>Fotoğraf ve video prodüksiyonu.</strong> Villa, yat ve oteller için drone ve yer çekimleri. Görseller ilan portallarında, rezervasyon sayfalarında ve sosyal medyada kullanılmak üzere hazırlanır.
      </p>
      <p>
        <strong>Yapay zeka destekli yazılım.</strong> İşletmeler için hızlı, çok dilli ve arama motorlarına hazır web siteleri, yönetim panelleri ve otomasyonlar. Seçili çalışmalar <a href="/isler">projeler</a> sayfasında yer alır.
      </p>

      <h2>Çalışma prensipleri</h2>
      <ul>
        <li><strong>Tek muhatap.</strong> İlk görüşmeden teslime kadar proje tarafımdan yürütülür; talepleriniz aracısız iletilir.</li>
        <li><strong>Şeffaf süreç.</strong> Web projeleri size özel bir önizleme adresinde gelişir; çekimlerde ham görüntüler aynı gün paylaşılır.</li>
        <li><strong>Yapay zeka ile verimlilik.</strong> Yapay zeka kod, metin ve test süreçlerini hızlandırır; tasarım kararları ve kalite kontrolü insan denetiminde kalır.</li>
      </ul>

      <h2>Ekipman ve belgeler</h2>
      {/* TODO(cihan): bu iki maddeyi gerçek bilgilerle değiştir (ekipman, lisans/sigorta). */}
      <ul class="todo-list" data-todo="cihan">
        <li>Eklenecek: drone modeli ve kamera ekipmanı</li>
        <li>Eklenecek: pilot lisansı, SHGM kaydı ve sigorta bilgisi</li>
      </ul>

      <h2>Hizmetler</h2>
      <ul>
        {services.map((s) => <li><a href={`/${s.id}`}>{s.data.name}</a>: {s.data.tagline.toLocaleLowerCase('tr-TR')}</li>)}
      </ul>

      <p class="muted">Açık kaynak çalışmalar: <a href={site.github} rel="me noopener" target="_blank">GitHub</a></p>
    </div>
  </div>

  <QuoteCta title="Projeniz için teklif alın" message="Merhaba Cihan Bey, bir proje için görüşmek istiyorum." />
</Desktop>

<style>
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    grid-template-areas: 'head portrait' 'story portrait';
    gap: 0 clamp(2rem, 1rem + 4vw, 5rem);
    padding-top: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .head { grid-area: head; }
  .head h1 { margin-top: 1.25rem; font-size: var(--fs-hero); letter-spacing: -0.035em; }
  .lead { margin-top: 1.1rem; max-width: 52ch; font-size: var(--fs-md); line-height: 1.5; color: rgb(245 245 247 / 0.86); }
  .portrait { grid-area: portrait; align-self: start; position: sticky; top: 4rem; border-radius: var(--r-window); overflow: hidden; }
  .story { grid-area: story; margin-top: 1rem; }
  .story p, .story li { color: rgb(245 245 247 / 0.86); }
  .todo-list li { color: var(--c-muted); border: 1.5px dashed rgb(255 255 255 / 0.25); border-radius: 6px; padding: 0.4rem 0.7rem; list-style: none; margin-left: -1.2em; }

  @media (max-width: 899px) {
    .wrap { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'head' 'portrait' 'story'; }
    .portrait { position: static; max-width: 300px; margin-top: 2rem; }
  }
</style>
