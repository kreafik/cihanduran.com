---
import { getCollection } from 'astro:content';
import Desktop from '../layouts/Desktop.astro';
import Hero from '../components/home/Hero.astro';
import StatStrip from '../components/home/StatStrip.astro';
import TechMarquee from '../components/home/TechMarquee.astro';
import WorkWall from '../components/home/WorkWall.astro';
import Bento from '../components/home/Bento.astro';
import MediaCinema from '../components/MediaCinema.astro';
import WorkShowcase from '../components/home/WorkShowcase.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../site.config.mjs';
import { t } from '../i18n';
import { buildHomeSchema } from '../lib/schema.mjs';

const allWork = await getCollection('isler');
const liveSites = allWork.filter((w) => w.data.url).length;
---
<Desktop
  title="Cihan Duran | Bodrum Drone Çekimi ve AI Destekli Yazılım"
  description={`Bodrum'da drone çekimi, emlak ve tekne fotoğrafçılığı, yapay zeka destekli web siteleri ve yazılımlar. ${site.stats.years} yıl, ${site.stats.software} yazılım projesi.`}
  path="/"
  jsonLd={buildHomeSchema()}
>
  <Hero />
  <WorkWall />

  <StatStrip liveSites={liveSites} />
  <TechMarquee />
  <Bento />
  <MediaCinema class="home-cinema" media={site.heroVideo.mp4 ? { type: 'video', src: site.heroVideo.mp4, webm: site.heroVideo.webm, poster: site.heroVideo.poster, label: "Bodrum'un drone ile havadan görüntüsü" } : { type: 'placeholder', label: 'drone videosu' }} words={['Havadan.', 'Koddan.']}>
    <div slot="caption" class="cinema-cap">
      <h2>Bodrum'u yukarıdan görün.</h2>
      <p>Villa, tekne, otel ve etkinlik için 4K hava çekimi. {site.stats.shoots} çekim teslim edildi.</p>
      <a class="btn btn-primary" href="/drone-cekimi-bodrum">Drone çekimi</a>
    </div>
  </MediaCinema>

  <WorkShowcase />

  <section class="section container about" aria-labelledby="hakkimda-baslik">
    <div class="about-photo">
      <Placeholder label="Cihan'ın portresi — sahada, drone ya da kamerayla, dikey" ratio="4 / 5" />
    </div>
    <div class="prose">
      <h2 id="hakkimda-baslik">İşi baştan sona ben yapıyorum</h2>
      <p>
        {site.stats.years} yıldır çekimi de, kurguyu da, sitenin kodunu da ben yapıyorum. Aradaki aracıları ortadan kaldırınca iş hem daha hızlı ilerliyor hem de ne istediğinizi ilk konuştuğunuz kişi sonuna kadar takip ediyor.
      </p>
      <p>
        Yapay zekayı bir kestirme olarak değil, bir ekip arkadaşı gibi kullanıyorum: kodu, metni ve testleri hızlandırıyor; kararları ve kaliteyi ben veriyorum.
      </p>
      <p><a href="/hakkimda">Hakkımda daha fazlası</a></p>
    </div>
  </section>

  <section class="section container cta" aria-labelledby="cta-baslik">
    <h2 id="cta-baslik">Projenizi anlatın, 24 saat içinde dönüş yapayım.</h2>
    <div class="cta-actions">
      <a class="btn btn-whatsapp" href={whatsappLink('Merhaba Cihan, bir proje için görüşmek istiyorum.')} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> {t('cta.whatsapp')}
      </a>
      <a class="btn btn-ghost" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
    </div>
  </section>
</Desktop>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .about-photo { border-radius: var(--r-window); overflow: hidden; }
  .about .prose p { color: rgb(245 245 247 / 0.86); }
  :global(.home-cinema) { margin-top: var(--space-section); }
  .cinema-cap h2 { font-size: var(--fs-xl); letter-spacing: -0.035em; max-width: 16ch; }
  .cinema-cap p { margin-top: 0.6rem; max-width: 46ch; color: rgb(245 245 247 / 0.85); font-size: var(--fs-md); }
  .cinema-cap .btn { margin-top: 1.4rem; }
  .cta h2 { font-size: var(--fs-xl); max-width: 18ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  @media (max-width: 899px) {
      .about { grid-template-columns: minmax(0, 1fr); }
    .about-photo { max-width: 320px; }
  }
</style>
