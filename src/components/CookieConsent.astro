---
// Çerez onay bandı (KVKK). Google Analytics çerezleri yalnız "Kabul et" ile yazılır (Consent Mode v2).
// Seçim localStorage'da "cd-consent" anahtarında durur; varsayılanlar Base.astro <head>'inde okunur.
// [data-consent-open] taşıyan her düğme bandı yeniden açar (footer, çerez politikası sayfası).
---
<section class="cc" id="cerez-bandi" role="region" aria-label="Çerez tercihi" hidden>
  <p class="cc-title">Çerez tercihi</p>
  <p class="cc-text">
    Ziyaret istatistikleri için Google Analytics çerezleri yalnız onayınızla kullanılır. Reklam çerezi kullanılmaz.{' '}
    <a href="/cerez-politikasi">Çerez politikası</a>
  </p>
  <div class="cc-actions">
    <button type="button" class="btn cc-btn" data-consent="denied">Reddet</button>
    <button type="button" class="btn cc-btn" data-consent="granted">Kabul et</button>
  </div>
</section>

<script>
  const KEY = 'cd-consent';
  const banner = document.getElementById('cerez-bandi');

  const read = (): string | null => {
    try { return localStorage.getItem(KEY); } catch { return null; }
  };
  const show = () => { if (banner) banner.hidden = false; };
  const hide = () => { if (banner) banner.hidden = true; };

  function choose(value: 'granted' | 'denied') {
    try { localStorage.setItem(KEY, value); } catch { /* gizli sekme: seçim yalnız bu sayfada geçerli */ }
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    w.gtag?.('consent', 'update', { analytics_storage: value });
    hide();
  }

  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => choose(b.dataset.consent as 'granted' | 'denied')),
  );
  document.querySelectorAll('[data-consent-open]').forEach((b) => b.addEventListener('click', show));

  const stored = read();
  if (stored !== 'granted' && stored !== 'denied') show();
</script>

<style>
  .cc {
    position: fixed;
    z-index: 96; /* WhatsApp düğmesinin (95) ve dock'un (90) üstünde */
    left: 1rem;
    bottom: calc(8px + 68px + 14px); /* dock'un üstü */
    width: min(400px, calc(100vw - 2rem));
    padding: 1.1rem 1.15rem 1rem;
    border-radius: 14px;
    background: rgb(36 36 40 / 0.96);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.16), 0 18px 50px rgb(0 0 0 / 0.5);
    backdrop-filter: saturate(160%) blur(20px);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .cc[hidden] { display: none; }
  .cc-title { font-weight: 600; color: var(--c-text); }
  .cc-text { margin-top: 0.35rem; color: var(--c-muted); }
  .cc-text a { color: var(--c-accent-text); }
  .cc-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.9rem; }
  /* İki seçenek eşit ağırlıkta (KVKK çerez rehberi: reddetmek kabul etmek kadar kolay olmalı). */
  .cc-btn {
    width: 100%;
    font-size: var(--fs-sm);
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.22);
    color: var(--c-text);
    cursor: pointer;
  }
  .cc-btn:hover { background: rgb(255 255 255 / 0.18); }
  .cc-btn:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; }

  @media (max-width: 899px) {
    .cc {
      left: 0.75rem;
      right: 0.75rem;
      width: auto;
      bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom) + 0.75rem);
    }
  }
</style>
