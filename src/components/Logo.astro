---
// Cihan Duran logosu (favicon'daki damla işareti), renk: currentColor.
interface Props { size?: number; class?: string }
const { size = 16, class: cls } = Astro.props;
// Dış damla r=222, iç boşluk r=98; merkez (222,222); sağ üst köşe sivri.
const drop = (r: number) => `M${222 - r} 222A${r} ${r} 0 0 1 222 ${222 - r}H${222 + r}V222A${r} ${r} 0 0 1 222 ${222 + r}A${r} ${r} 0 0 1 ${222 - r} 222Z`;
---
<svg class={cls} width={size} height={size} viewBox="0 0 444 444" aria-hidden="true" focusable="false">
  <path fill="currentColor" fill-rule="evenodd" d={`${drop(222)}${drop(98)}`} />
</svg>
