---
// İş kartı: pencere çerçevesinde ekran görüntüsü + ad, sektör, tek satır sonuç.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Window from './Window.astro';
import Placeholder from './Placeholder.astro';

interface Props { entry: CollectionEntry<'isler'>; headingLevel?: 'h2' | 'h3'; eager?: boolean }
const { entry, headingLevel: H = 'h3', eager = false } = Astro.props;
const d = entry.data;
const host = d.url ? new URL(d.url).host : d.name;
---
<article class="project">
  <a class="project-link" href={`/isler/${entry.id}`}>
    <Window title={host}>
      <div class="shot">
        {d.desktopShot
          ? <Image src={d.desktopShot} alt={`${d.name} web sitesinin ana sayfası`} widths={[400, 640, 880]} sizes="(max-width: 899px) 100vw, 360px" loading={eager ? 'eager' : 'lazy'} />
          : <Placeholder label={`${host} ekran görüntüsü`} ratio="16 / 10" />}
      </div>
    </Window>
    <div class="project-text">
      <H class="project-name">{d.name}</H>
      <p class="project-meta">{d.sector}, {d.location}</p>
      <p class="project-summary">{d.summary}</p>
    </div>
  </a>
</article>

<style>
  .project-link { display: block; color: var(--c-text); text-decoration: none; }
  .project-link :global(.window) { transition: transform 0.2s ease; }
  .project-link:hover :global(.window) { transform: translateY(-3px); }
  .project-link:hover .project-name { color: var(--c-accent-text); }
  .shot { aspect-ratio: 16 / 10; overflow: hidden; background: #111; }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .shot :global(.placeholder) { border: 0; border-radius: 0; }
  .project-text { padding: 1rem 0.15rem 0; }
  .project-name { font-size: var(--fs-md); transition: color 0.15s ease; }
  .project-meta { color: var(--c-muted); font-size: var(--fs-sm); margin-top: 0.2rem; }
  .project-summary { margin-top: 0.45rem; font-size: 0.9375rem; }
</style>
