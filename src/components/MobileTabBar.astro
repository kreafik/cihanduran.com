---
// Telefonda dock'un yerini alan alt sekme çubuğu (< 900px).
import { t } from '../i18n';
import { tabNav, isActive } from '../lib/nav';
import Icon from './Icon.astro';

interface Props { path: string }
const { path } = Astro.props;
---
<nav class="tabbar" aria-label={t('nav.main')}>
  <ul>
    {tabNav.map((item) => (
      <li>
        <a href={item.href} aria-current={isActive(path, item.href) ? 'page' : undefined}>
          <Icon name={item.icon} size={24} />
          <span>{t(item.key)}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabbar {
    display: none;
    position: fixed;
    inset: auto 0 0 0;
    z-index: 90;
    padding-bottom: env(safe-area-inset-bottom);
    background: rgb(28 28 30 / 0.82);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-top: 0.5px solid var(--c-line);
  }
  ul { display: grid; grid-template-columns: repeat(5, 1fr); list-style: none; padding: 0; }
  a {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    height: var(--tabbar-h);
    color: var(--c-muted);
    font-size: 0.6875rem; font-weight: 500;
    text-decoration: none;
  }
  a[aria-current='page'] { color: var(--c-accent-text); }
  @media (max-width: 899px) { .tabbar { display: block; } }
</style>
