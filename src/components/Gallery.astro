---
// Çekim galerisi: masonry (CSS sütunları), tıklayınca tam ekran görüntüleyici (<dialog>).
// JS yoksa her kare 1600px görsele bağlanır.
import { media, type Shoot } from '../lib/media';

interface Props { shoot: Shoot; name: string; skipFirst?: boolean }
const { shoot, name, skipFirst = false } = Astro.props;
const photos = skipFirst ? shoot.photos.slice(1) : shoot.photos;
---
<div class="gallery" data-gallery>
  {photos.map((p, i) => (
    <a
      class="g-item"
      href={media.photoSrc(shoot, p, 1600)}
      data-full={media.photoSrc(shoot, p, 1600)}
      data-w={p.w}
      data-h={p.h}
      style={`aspect-ratio:${p.w} / ${p.h}`}
    >
      <img
        src={media.photoSrc(shoot, p, 640)}
        srcset={media.photoSrcset(shoot, p)}
        sizes="(max-width: 599px) 50vw, (max-width: 1099px) 33vw, 25vw"
        width={p.w}
        height={p.h}
        alt={`${name}, fotoğraf ${i + (skipFirst ? 2 : 1)}`}
        loading={i < 4 ? 'eager' : 'lazy'}
        decoding="async"
      />
    </a>
  ))}
</div>

<dialog class="lightbox" data-lightbox aria-label={`${name} galerisi`}>
  <figure><img alt="" /><figcaption></figcaption></figure>
  <button class="lb-btn lb-close" type="button" aria-label="Kapat" data-lb="close">✕</button>
  <button class="lb-btn lb-prev" type="button" aria-label="Önceki fotoğraf" data-lb="prev">‹</button>
  <button class="lb-btn lb-next" type="button" aria-label="Sonraki fotoğraf" data-lb="next">›</button>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement;
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector('figcaption')!;
    const items = [...gallery.querySelectorAll<HTMLAnchorElement>('.g-item')];
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const a = items[index];
      const thumb = a.querySelector('img')!;
      img.src = a.dataset.full!;
      img.alt = thumb.alt;
      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      cap.textContent = `${index + 1} / ${items.length}`;
      // bir sonrakini önceden yükle
      const next = items[(index + 1) % items.length];
      if (next) new Image().src = next.dataset.full!;
    };

    items.forEach((a, i) => a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      opener = a;
      show(i);
      dialog.showModal();
    }));
    dialog.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (action === 'close' || e.target === dialog) dialog.close();
      else if (action === 'prev') show(index - 1);
      else if (action === 'next') show(index + 1);
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => opener?.focus());
    let x0: number | null = null;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  });
</script>

<style>
  .gallery { columns: 4 260px; column-gap: 12px; }
  .g-item {
    display: block;
    margin-bottom: 12px;
    break-inside: avoid;
    border-radius: 10px;
    overflow: hidden;
    background: #161618;
    cursor: zoom-in;
  }
  .g-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease, opacity 0.2s ease; }
  .g-item:hover img { transform: scale(1.03); }
  .g-item:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: rgb(0 0 0 / 0.94);
    color: #fff;
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.6); }
  .lightbox[open] { display: grid; place-items: center; }
  figure { margin: 0; display: grid; place-items: center; gap: 0.6rem; }
  figure img { max-width: 94vw; max-height: 86dvh; width: auto; height: auto; object-fit: contain; border-radius: 6px; }
  figcaption { font-size: var(--fs-sm); color: rgb(255 255 255 / 0.65); font-variant-numeric: tabular-nums; }
  .lb-btn {
    position: absolute; display: grid; place-items: center;
    width: 48px; height: 48px; border-radius: 50%; border: 0;
    background: rgb(255 255 255 / 0.1); color: #fff; font-size: 1.6rem; line-height: 1;
  }
  .lb-btn:hover { background: rgb(255 255 255 / 0.2); }
  .lb-close { top: 1rem; right: 1rem; font-size: 1.1rem; }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 599px) {
    .gallery { columns: 2; column-gap: 8px; }
    .g-item { margin-bottom: 8px; }
    .lb-prev, .lb-next { top: auto; bottom: 1.25rem; transform: none; }
  }
</style>
