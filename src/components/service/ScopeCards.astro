---
// Hizmet kapsamı: macOS Ayarlar penceresi düzeni. Solda konu listesi (sekme), sağda seçilen konunun
// fotoğrafı ve açıklaması. JS yoksa ve < 760px'te tüm konular alt alta görünür (içerik HTML'de tam).
import Window from '../Window.astro';
import Icon, { type IconName } from '../Icon.astro';
import { media, shoots } from '../../lib/media';

interface Item { title: string; desc: string; icon?: string; shoot?: string }
interface Props { title: string; items: Item[]; service: string }
const { title, items, service } = Astro.props;

// Her konuya macOS ayarlar ikonları gibi ayrı renk.
const TINTS = ['#0a84ff', '#30b0c7', '#ff9f0a', '#bf5af2', '#34c759', '#ff375f'];
const rows = items.map((it, i) => {
  const s = it.shoot ? shoots.find((x) => x.slug === it.shoot && x.photos.length) : undefined;
  return { ...it, icon: (it.icon ?? 'check') as IconName, tint: TINTS[i % TINTS.length], shoot: s, id: `kapsam-${i}` };
});
---
<section class="section container" aria-labelledby="kapsam">
  <h2 id="kapsam">{title}</h2>
  <Window title={`${service} — ${title}`} class="scope-win">
    <div class="scope" data-scope>
      <div class="side" role="tablist" aria-label={title} aria-orientation="vertical">
        {rows.map((r, i) => (
          <button type="button" role="tab" id={`${r.id}-tab`} aria-controls={r.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={`--tint:${r.tint}`}>
            <span class="glyph"><Icon name={r.icon} size={17} /></span>
            <span class="label">{r.title}</span>
          </button>
        ))}
      </div>
      <div class="panes">
        {rows.map((r, i) => (
          <article class="pane" id={r.id} role="tabpanel" aria-labelledby={`${r.id}-tab`} data-pane hidden={i === 0 ? undefined : true} style={`--tint:${r.tint}`}>
            <div class="visual">
              {r.shoot ? (
                <img src={media.photoSrc(r.shoot, r.shoot.photos[0], 1600)} srcset={media.photoSrcset(r.shoot, r.shoot.photos[0])}
                  sizes="(max-width: 759px) 100vw, 60vw" width={r.shoot.photos[0].w} height={r.shoot.photos[0].h}
                  alt={`${r.shoot.project} çekiminden`} loading="lazy" decoding="async" />
              ) : (
                <div class="art" aria-hidden="true"><span class="art-glyph"><Icon name={r.icon} size={56} /></span></div>
              )}
            </div>
            <div class="text">
              <h3><span class="glyph sm" aria-hidden="true"><Icon name={r.icon} size={15} /></span>{r.title}</h3>
              <p>{r.desc}</p>
              {r.shoot && <a class="link-arrow" href={`/isler/${r.shoot.slug}`}>Örnek çekim: {r.shoot.project}<span class="la-icon"><Icon name="arrow" size={14} /></span></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </Window>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-scope]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
    root.classList.add('is-tabs');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panes[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowDown' || k === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (k === 'ArrowUp' || k === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
        if (k === 'Home') { e.preventDefault(); select(0, true); }
        if (k === 'End') { e.preventDefault(); select(tabs.length - 1, true); }
      });
    });
  });
</script>

<style>
  .section :global(.scope-win) { margin-top: 1.5rem; }
  .scope { display: grid; grid-template-columns: minmax(220px, 300px) minmax(0, 1fr); height: clamp(460px, 40vw, 580px); background: #1e1e20; }

  /* Kenar çubuğu (macOS Ayarlar) */
  .side { display: flex; flex-direction: column; gap: 2px; padding: 12px 10px; background: rgb(255 255 255 / 0.035); border-right: 0.5px solid rgb(0 0 0 / 0.5); }
  .side button {
    display: flex; align-items: center; gap: 0.7rem;
    min-height: 44px; padding: 0.45rem 0.6rem;
    border: 0; border-radius: 8px; background: transparent;
    color: rgb(245 245 247 / 0.86); font: inherit; font-size: 0.9375rem; text-align: left; cursor: pointer;
  }
  .side button:hover { background: rgb(255 255 255 / 0.06); }
  .side button[aria-selected='true'] { background: rgb(10 132 255 / 0.85); color: #fff; }
  .side button:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 1px; }
  .glyph {
    display: inline-grid; place-items: center; flex: none;
    width: 28px; height: 28px; border-radius: 7px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tint) 88%, #fff), var(--tint));
    color: #fff;
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.25), 0 1px 2px rgb(0 0 0 / 0.4);
  }
  .glyph.sm { width: 24px; height: 24px; border-radius: 6px; margin-right: 0.6rem; vertical-align: -5px; }
  .label { line-height: 1.25; }

  /* Ayrıntı alanı */
  .panes { display: grid; min-width: 0; min-height: 0; }
  .pane { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-height: 0; }
  .pane[hidden] { display: none; }
  .is-tabs .pane:not([hidden]) { animation: pane-in 0.35s ease both; }
  @keyframes pane-in { from { opacity: 0; transform: translateY(6px); } }
  .visual { position: relative; min-height: 0; overflow: hidden; }
  .visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 55%, #1e1e20); pointer-events: none; }
  .art {
    position: absolute; inset: 0; display: grid; place-items: center;
    background:
      radial-gradient(60% 80% at 30% 20%, color-mix(in srgb, var(--tint) 45%, transparent), transparent 70%),
      radial-gradient(50% 70% at 80% 90%, rgb(191 90 242 / 0.25), transparent 70%),
      #141416;
  }
  .art::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(closest-side, #000, transparent);
  }
  .art-glyph {
    position: relative; display: grid; place-items: center;
    width: 112px; height: 112px; border-radius: 26px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tint) 85%, #fff), var(--tint));
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25), 0 18px 40px color-mix(in srgb, var(--tint) 45%, transparent);
  }
  .art-glyph :global(svg) { stroke-width: 1.4; }
  .text { position: relative; padding: 0 1.75rem 1.75rem; margin-top: -1rem; }
  .text h3 { font-size: 1.3rem; letter-spacing: -0.02em; }
  .text p { margin-top: 0.6rem; max-width: 62ch; color: rgb(245 245 247 / 0.78); line-height: 1.55; }
  .text .link-arrow { margin-top: 1rem; }

  /* Mobil ve JS'siz: liste yok, tüm konular alt alta */
  .scope:not(.is-tabs) { grid-template-columns: 1fr; height: auto; }
  .scope:not(.is-tabs) .visual { aspect-ratio: 16 / 9; }
  .scope:not(.is-tabs) .side { display: none; }
  .scope:not(.is-tabs) .pane[hidden] { display: grid; }
  @media (max-width: 759px) {
    .scope { grid-template-columns: 1fr; height: auto; }
    .side { display: none; }
    .pane[hidden] { display: grid; }
    .pane + .pane { border-top: 0.5px solid rgb(255 255 255 / 0.08); }
    .visual { min-height: 0; aspect-ratio: 16 / 9; }
    .text { padding: 0 1.1rem 1.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .is-tabs .pane:not([hidden]) { animation: none; } }
</style>
