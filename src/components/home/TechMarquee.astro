---
// Kullandığım teknolojiler — yalnız Cihan'ın repolarında görülenler. Logolar simple-icons (CC0).
import {
  siAstro, siTypescript, siReact, siNextdotjs, siTailwindcss, siCloudflareworkers, siHono, siSupabase,
  siPrisma, siZod, siReactquery, siThreedotjs, siPython, siSolidity, siWordpress, siClaude, siNodedotjs, siVite,
} from 'simple-icons';

const icons = [
  [siClaude, 'Claude (AI)'], [siAstro, 'Astro'], [siTypescript, 'TypeScript'], [siReact, 'React'], [siNextdotjs, 'Next.js'],
  [siTailwindcss, 'Tailwind CSS'], [siCloudflareworkers, 'Cloudflare Workers'], [siHono, 'Hono'], [siSupabase, 'Supabase'],
  [siPrisma, 'Prisma'], [siZod, 'Zod'], [siReactquery, 'TanStack Query'], [siNodedotjs, 'Node.js'], [siVite, 'Vite'],
  [siThreedotjs, 'Three.js'], [siPython, 'Python'], [siSolidity, 'Solidity'], [siWordpress, 'WordPress'],
] as const;

// Koyu marka renkleri koyu zeminde görünmez; onları beyaz göster.
const lum = (hex: string) => {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const items = icons.map(([ic, name]) => ({ name, path: ic.path, color: lum(ic.hex) < 0.25 ? '#ffffff' : `#${ic.hex}` }));
---
<section class="tech" aria-labelledby="tech-baslik">
  <div class="container tech-head">
    <h2 id="tech-baslik">Teknolojiler</h2>
    <p>Projelerde kullanılan başlıca teknolojiler ve araçlar.</p>
  </div>
  <div class="marquee">
    <ul class="track">
      {[0, 1].map((copy) => items.map((it) => (
        <li aria-hidden={copy === 1 ? 'true' : undefined} style={`--brand:${it.color}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={it.path} /></svg>
          <span>{it.name}</span>
        </li>
      )))}
    </ul>
  </div>
</section>

<style>
  .tech { padding-top: clamp(3rem, 2rem + 3vw, 5rem); }
  .tech-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; }
  .tech-head p { color: var(--c-muted); }
  .marquee {
    margin-top: 1.75rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track { display: flex; gap: 0.75rem; width: max-content; list-style: none; padding: 0.5rem 0; animation: scroll 55s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  li {
    display: inline-flex; align-items: center; gap: 0.65rem;
    padding: 0.7rem 1.1rem; border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.04); border: 0.5px solid rgb(255 255 255 / 0.1);
    color: rgb(245 245 247 / 0.8); font-weight: 600; white-space: nowrap;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  li svg { width: 22px; height: 22px; fill: rgb(245 245 247 / 0.75); transition: fill 0.2s ease; }
  li:hover { border-color: color-mix(in srgb, var(--brand) 55%, transparent); background: color-mix(in srgb, var(--brand) 10%, transparent); }
  li:hover svg { fill: var(--brand); }
  @keyframes scroll { to { transform: translateX(calc(-50% - 0.375rem)); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .track li[aria-hidden] { display: none; }
    .marquee { mask-image: none; -webkit-mask-image: none; }
  }
</style>
