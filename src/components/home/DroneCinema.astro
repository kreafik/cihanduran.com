---
// Drone sinema geçişi (21st.dev "Scroll media expansion hero" esinli).
// Kaydırdıkça ortadaki görüntü tam ekrana açılır, "Havadan." / "Koddan." iki yana ayrılır.
// JS yoksa veya azaltılmış harekette: --p = 1 (tam açık, statik).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '../../site.config.mjs';

const drone = (await getCollection('hizmetler')).find((s) => s.data.workCategory === 'drone')!;
---
<section class="cinema" aria-labelledby="sinema-baslik" data-cinema>
  <div class="stage">
    <div class="media">
      {drone.data.heroImage
        ? <Image src={drone.data.heroImage} alt="Bodrum'dan drone ile hava çekimi" widths={[960, 1600, 2400]} sizes="100vw" />
        : (
          <>
            {/* TODO(cihan): buraya drone videosu (muted loop playsinline) ya da tam genişlik drone fotoğrafı gelecek. */}
            <div class="aerial" data-todo="cihan" role="img" aria-label="Drone görseli yakında"><span>GÖRSEL: drone videosu — Bodrum koyu, gün batımı, yatay</span></div>
          </>
        )}
    </div>
    <p class="word w-left" aria-hidden="true">Havadan.</p>
    <p class="word w-right" aria-hidden="true">Koddan.</p>
    <div class="cap">
      <h2 id="sinema-baslik">Bodrum'u yukarıdan görün.</h2>
      <p>Villa, tekne, otel ve etkinlik için 4K hava çekimi. {site.stats.shoots} çekim teslim edildi.</p>
      <a class="btn btn-primary" href={`/${drone.id}`}>Drone çekimi</a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-cinema]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    root.classList.add('is-anim');
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const travel = r.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / (travel * 0.85)));
      root.style.setProperty('--p', p.toFixed(4));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .cinema { --p: 1; position: relative; margin-top: var(--space-section); }
  .cinema.is-anim { --p: 0; height: 260vh; }
  .stage {
    position: relative;
    height: calc(100vh - var(--menubar-h));
    min-height: 520px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .is-anim .stage { position: sticky; top: var(--menubar-h); }

  .media {
    position: absolute;
    inset: 0;
    clip-path: inset(calc((1 - var(--p)) * 24%) calc((1 - var(--p)) * 30%) round calc((1 - var(--p)) * 28px));
    will-change: clip-path;
  }
  .media :global(img), .aerial { width: 100%; height: 100%; object-fit: cover; }
  .aerial {
    position: relative;
    background: linear-gradient(165deg, #06293a 0%, #0d5f73 35%, #2aa3a8 55%, #d8c9a0 72%, #5d7448 86%, #2c3b24 100%);
  }
  .aerial span { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 0.3rem 0.7rem; border-radius: 6px; background: rgb(0 0 0 / 0.35); color: rgb(255 255 255 / 0.8); font-size: var(--fs-sm); text-align: center; }
  .media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 40%, rgb(0 0 0 / calc(0.75 * var(--p)))); }

  .word {
    position: absolute;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1rem + 6.5vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    opacity: calc(1 - var(--p) * 1.4);
    pointer-events: none;
    z-index: 1;
  }
  /* Görüntünün üst-sol ve alt-sağ köşelerine biner; açılırken dışarı kayar. */
  .w-left { left: 6vw; top: calc(24% - 0.55em); transform: translateX(calc(var(--p) * -50vw)); }
  .w-right {
    right: 6vw; bottom: calc(24% - 0.45em); transform: translateX(calc(var(--p) * 50vw));
    background: linear-gradient(90deg, #b9a6ff, #9fd3ff); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .cinema:not(.is-anim) .word { display: none; }

  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 var(--gutter) clamp(5rem, 4rem + 4vw, 7rem);
    width: min(100%, var(--container));
    margin-inline: auto;
    opacity: clamp(0, calc((var(--p) - 0.65) * 3), 1);
    transform: translateY(calc((1 - var(--p)) * 30px));
  }
  .cap h2 { font-size: var(--fs-xl); letter-spacing: -0.035em; max-width: 16ch; }
  .cap p { margin-top: 0.6rem; max-width: 46ch; color: rgb(245 245 247 / 0.85); font-size: var(--fs-md); }
  .cap .btn { margin-top: 1.4rem; }

  @media (max-width: 899px) {
    .w-left { left: var(--gutter); }
    .w-right { right: var(--gutter); }
    .cinema.is-anim { height: 220vh; }
    .stage { height: calc(100svh - 52px); top: 52px; }
  }
</style>
