---
// Sinema geçişi (21st.dev "Scroll media expansion hero" esinli): kaydırdıkça ortadaki medya tam ekrana açılır.
// Slotlar: "intro" (üstte, hep görünür — ör. h1), "caption" (sonda belirir). İsteğe bağlı iki yana kayan kelimeler.
// JS yoksa veya azaltılmış harekette: --p = 1 (tam açık, statik).
// open: medya baştan tam açık gelir (proje sayfaları); altta aşağı kaydırma ipucu gösterilir.
export type CinemaMedia =
  | { type: 'video'; src: string; webm?: string; poster?: string | null; label: string }
  | { type: 'image'; src: string; srcset?: string; sizes?: string; alt: string; width: number; height: number }
  | { type: 'placeholder'; label: string };

interface Props { media: CinemaMedia; words?: [string, string]; first?: boolean; open?: boolean; class?: string }
const { media, words, first = false, open = false, class: cls } = Astro.props;
---
<section class:list={['cinema', cls, { first, open }]} data-cinema={open ? undefined : ''}>
  <div class="stage">
    <div class="media">
      {media.type === 'video' && (
        <video autoplay muted loop playsinline preload={first ? 'auto' : 'none'} poster={media.poster ?? undefined} aria-label={media.label}>
          {media.webm && <source src={media.webm} type="video/webm" />}
          <source src={media.src} type="video/mp4" />
        </video>
      )}
      {media.type === 'image' && (
        <img src={media.src} srcset={media.srcset} sizes={media.sizes ?? '100vw'} alt={media.alt} width={media.width} height={media.height}
          loading={first ? 'eager' : 'lazy'} fetchpriority={first ? 'high' : undefined} decoding="async" />
      )}
      {media.type === 'placeholder' && (
        <div class="ph" data-todo="cihan" role="img" aria-label={media.label}><span>GÖRSEL: {media.label}</span></div>
      )}
    </div>
    {words && <p class="word w-left" aria-hidden="true">{words[0]}</p>}
    {words && <p class="word w-right" aria-hidden="true">{words[1]}</p>}
    {Astro.slots.has('intro') && <div class="intro"><slot name="intro" /></div>}
    {Astro.slots.has('caption') && <div class="cap"><slot name="caption" /></div>}
    {open && (
      <a class="scroll-hint" href="#icerik-devam" data-scroll-hint>
        <span class="mouse" aria-hidden="true"><i></i></span>
        <span>Aşağı kaydırın</span>
      </a>
    )}
  </div>
  {open && <span id="icerik-devam" class="anchor" aria-hidden="true"></span>}
</section>

<script>
  // Kaydırma ipucu: sayfa biraz kaydırılınca kaybolur.
  document.querySelectorAll<HTMLElement>('[data-scroll-hint]').forEach((hint) => {
    const onScroll = () => hint.classList.toggle('gone', window.scrollY > 40);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-cinema]').forEach((root) => {
    if (reduce) return;
    root.classList.add('is-anim');
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const travel = r.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / (travel * 0.85)));
      root.style.setProperty('--p', p.toFixed(4));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  });
</script>

<style>
  .cinema { --p: 1; position: relative; }
  .cinema.is-anim { --p: 0; height: 250vh; }
  .stage {
    position: relative;
    height: calc(100vh - var(--menubar-h));
    min-height: 520px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .is-anim .stage { position: sticky; top: var(--menubar-h); }

  .media {
    position: absolute;
    inset: 0;
    clip-path: inset(calc((1 - var(--p)) * 24%) calc((1 - var(--p)) * 30%) round calc((1 - var(--p)) * 28px));
    will-change: clip-path;
  }
  /* Proje sayfasında başlık için üstte daha çok yer */
  .first .media { clip-path: inset(calc((1 - var(--p)) * 30%) calc((1 - var(--p)) * 26%) calc((1 - var(--p)) * 14%) round calc((1 - var(--p)) * 28px)); }
  .media img, .media video, .ph { width: 100%; height: 100%; object-fit: cover; }
  .ph { position: relative; background: linear-gradient(165deg, #06293a 0%, #0d5f73 35%, #2aa3a8 55%, #d8c9a0 72%, #5d7448 86%, #2c3b24 100%); }
  .ph span { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 0.3rem 0.7rem; border-radius: 6px; background: rgb(0 0 0 / 0.35); color: rgb(255 255 255 / 0.8); font-size: var(--fs-sm); text-align: center; }
  .media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgb(0 0 0 / calc(0.45 * var(--p))), transparent 30%, transparent 45%, rgb(0 0 0 / calc(0.75 * var(--p)))); pointer-events: none; }

  .word {
    position: absolute;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 1rem + 6.5vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    opacity: calc(1 - var(--p) * 1.4);
    pointer-events: none;
    z-index: 1;
  }
  .w-left { left: 6vw; top: calc(24% - 0.55em); transform: translateX(calc(var(--p) * -50vw)); }
  .w-right {
    right: 6vw; bottom: calc(24% - 0.45em); transform: translateX(calc(var(--p) * 50vw));
    background: linear-gradient(90deg, #b9a6ff, #9fd3ff); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .cinema:not(.is-anim) .word { display: none; }

  .intro {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    text-shadow: 0 2px 24px rgb(0 0 0 / calc(0.6 * var(--p)));
  }
  .cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
    padding-bottom: clamp(5rem, 4rem + 4vw, 7rem);
    opacity: clamp(0, calc((var(--p) - 0.65) * 3), 1);
    transform: translateY(calc((1 - var(--p)) * 30px));
  }

  .anchor { display: block; scroll-margin-top: var(--menubar-h); }
  .scroll-hint {
    position: absolute;
    right: max(var(--gutter), (100% - var(--container)) / 2);
    bottom: clamp(5rem, 4rem + 4vw, 7rem);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.25rem 0.5rem;
    color: rgb(255 255 255 / 0.85);
    font-size: var(--fs-sm);
    text-decoration: none;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
    transition: opacity 0.3s ease;
  }
  .scroll-hint:hover { color: #fff; }
  .scroll-hint.gone { opacity: 0; pointer-events: none; }
  .mouse { position: relative; width: 22px; height: 34px; border-radius: 12px; box-shadow: inset 0 0 0 1.5px currentColor; }
  .mouse i { position: absolute; left: 50%; top: 7px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: currentColor; animation: wheel 1.6s ease-in-out infinite; }
  @keyframes wheel { 0% { opacity: 0; transform: translateY(-3px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .mouse i { animation: none; } }

  @media (max-width: 899px) {
    .scroll-hint { right: auto; left: 50%; bottom: calc(var(--tabbar-h, 64px) + 0.25rem); transform: translateX(-50%); }
    .scroll-hint span:last-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .open .cap { padding-bottom: calc(var(--tabbar-h, 64px) + 3.5rem); }
    .w-left { left: var(--gutter); }
    .w-right { right: var(--gutter); }
    .cinema.is-anim { height: 210vh; }
    .stage { height: calc(100svh - 52px); }
    .is-anim .stage { top: 52px; }
    .first .media { clip-path: inset(calc((1 - var(--p)) * 34%) calc((1 - var(--p)) * 8%) calc((1 - var(--p)) * 16%) round calc((1 - var(--p)) * 20px)); }
  }
</style>
