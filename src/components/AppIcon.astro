---
// macOS uygulama ikonu dilinde (squircle + degrade + beyaz glif) dock/widget ikonu.
import { Image } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import terminalPng from '../assets/dock/terminal.png';

export type AppName = 'terminal' | 'drone' | 'photo' | 'ai' | 'work' | 'about' | 'contact' | 'iban';
interface Props { app: AppName; size?: number }
const { app, size = 48 } = Astro.props;

const apps: Record<Exclude<AppName, 'terminal'>, { icon: IconName; from: string; to: string }> = {
  drone: { icon: 'drone', from: '#5ac8fa', to: '#0a5fb4' },
  photo: { icon: 'camera', from: '#ffc24b', to: '#f2545b' },
  ai: { icon: 'code', from: '#8e7bff', to: '#3a2bcf' },
  work: { icon: 'folder', from: '#74c7ff', to: '#1c7ed6' },
  about: { icon: 'user', from: '#98989d', to: '#48484a' },
  contact: { icon: 'chat', from: '#4cd964', to: '#13994a' },
  iban: { icon: 'bank', from: '#3d8bfd', to: '#0d47a1' },
};
const a = app === 'terminal' ? null : apps[app];
---
{a ? (
  <span class="app-icon" style={`--s:${size}px;--from:${a.from};--to:${a.to}`} aria-hidden="true">
    <Icon name={a.icon} size={Math.round(size * 0.56)} />
  </span>
) : (
  <Image src={terminalPng} alt="" width={size} height={size} class="app-icon-img" style={`--s:${size}px`} loading="eager" />
)}

<style>
  .app-icon {
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 22.5%;
    background: linear-gradient(180deg, var(--from), var(--to));
    color: #fff;
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.25), 0 1px 2px rgb(0 0 0 / 0.35);
    flex: none;
  }
  .app-icon :global(svg) { stroke-width: 1.9; }
  .app-icon-img { width: var(--s); height: var(--s); flex: none; }
</style>
