---
// macOS tarzı 3B uygulama ikonu (src/assets/dock/*.png, şeffaf squircle). Dock ve widget'larda kullanılır.
import { Image } from 'astro:assets';
import home from '../assets/dock/home.png';
import terminal from '../assets/dock/terminal.png';
import drone from '../assets/dock/drone.png';
import photo from '../assets/dock/photo.png';
import ai from '../assets/dock/ai.png';
import work from '../assets/dock/work.png';
import about from '../assets/dock/about.png';
import contact from '../assets/dock/contact.png';
import iban from '../assets/dock/iban.png';

const icons = { home, terminal, drone, photo, ai, work, about, contact, iban };
export type AppName = keyof typeof icons;
interface Props { app: AppName; size?: number; eager?: boolean }
const { app, size = 48, eager = false } = Astro.props;
// Retina ve dock büyütmesi için ikon 2 katı çözünürlükte üretilir.
const px = Math.min(256, Math.round(size * 2.6));
---
<Image
  src={icons[app]}
  alt=""
  width={px}
  height={px}
  class="app-icon"
  style={`--s:${size}px`}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  format="webp"
  quality={86}
/>

<style>
  .app-icon {
    display: block;
    width: var(--s);
    height: var(--s);
    flex: none;
    filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.35)) drop-shadow(0 4px 8px rgb(0 0 0 / 0.18));
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
