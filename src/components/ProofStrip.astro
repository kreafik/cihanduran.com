---
// Kanıt şeridi. "TODO(cihan)" ile başlayan değerler uydurulmaz; görünür yer tutucu olarak çizilir.
interface Props { items: { value: string; label: string }[] }
const { items } = Astro.props;
---
<dl class="proof">
  {items.map((it) => {
    const todo = it.value.startsWith('TODO');
    return (
      <div class:list={['proof-item', { todo }]} data-todo={todo ? 'cihan' : undefined}>
        <dt>{it.label}</dt>
        <dd>{todo ? 'Sayı eklenecek' : it.value}</dd>
      </div>
    );
  })}
</dl>

<style>
  .proof {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    border-top: 0.5px solid var(--c-line);
    border-bottom: 0.5px solid var(--c-line);
  }
  .proof-item { display: flex; flex-direction: column-reverse; gap: 0.25rem; padding: 1.5rem 1.5rem 1.5rem 0; }
  .proof-item + .proof-item { padding-left: 1.5rem; border-left: 0.5px solid var(--c-line); }
  dd { font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  dt { color: var(--c-muted); font-size: var(--fs-sm); }
  .todo dd { color: var(--c-muted); font-size: var(--fs-md); border: 1.5px dashed rgb(255 255 255 / 0.28); border-radius: 6px; padding: 0.2rem 0.5rem; align-self: flex-start; }
  @media (max-width: 599px) {
    .proof-item, .proof-item + .proof-item { padding: 1.1rem 0; border-left: 0; }
    .proof-item + .proof-item { border-top: 0.5px solid var(--c-line); }
  }
</style>
