---
import { t } from '../i18n';
import { mainNav, isActive } from '../lib/nav';
import Icon from './Icon.astro';
import { site } from '../site.config.mjs';

interface Props { path: string }
const { path } = Astro.props;
import Logo from './Logo.astro';
import MobileMenu from './MobileMenu.astro';
---
<header class="menubar">
  <a class="skip-link" href="#icerik">İçeriğe geç</a>
  <div class="menubar-inner">
    <a class="brand" href="/" aria-label={`${site.name}, ${t('nav.home')}`}>
      <Logo size={15} class="brand-mark" />
      {site.name}
    </a>

    <nav class="menubar-nav" aria-label={t('nav.main')}>
      <ul>
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>{t('nav.home')}</a></li>
        {mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(path, item.href) ? 'page' : undefined}>{t(item.key)}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="menubar-right">
      <a class="menubar-wa" href={site.whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={15} />
        <span>WhatsApp</span>
      </a>
      <time class="menubar-clock" data-clock aria-hidden="true"></time>
    </div>

    <button class="menu-btn" type="button" popovertarget="mobil-menu" aria-label={t('nav.menu')}>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>
<MobileMenu path={path} />

<script>
  // Saat yalnız istemcide çizilir (HTML'de yok; önbellek ve hydration sorunsuz).
  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('tr-TR', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Istanbul' });
    const tick = () => { el.textContent = fmt.format(new Date()); };
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .menubar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(28 28 30 / 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 0.5px solid var(--c-line);
  }
  .menubar-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: var(--menubar-h);
    padding-inline: 0.9rem;
    font-size: 0.8125rem;
  }
  .brand {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-weight: 700; color: var(--c-text); text-decoration: none; white-space: nowrap;
  }
  .brand :global(.brand-mark) { flex: none; color: #fff; }
  .menubar-nav ul { display: flex; gap: 1.1rem; list-style: none; padding: 0; }
  .menubar-nav a, .menubar-wa { color: rgb(245 245 247 / 0.86); text-decoration: none; }
  .menubar-nav a:hover, .menubar-wa:hover { color: #fff; }
  .menubar-nav a[aria-current='page'] { color: #fff; font-weight: 600; }
  .menubar-right { margin-left: auto; display: flex; align-items: center; gap: 1rem; white-space: nowrap; }
  .menubar-wa { display: inline-flex; align-items: center; gap: 0.35rem; }
  .menubar-clock { color: rgb(245 245 247 / 0.86); font-variant-numeric: tabular-nums; min-width: 9.5em; text-align: right; }

  .menu-btn { display: none; }

  @media (max-width: 899px) {
    .menubar-inner { height: 52px; padding-inline: var(--gutter); font-size: 1rem; }
    .menubar-nav, .menubar-right { display: none; }
    .menu-btn {
      display: grid; place-items: center;
      width: 44px; height: 44px; margin-left: auto; margin-right: -10px;
      border: 0; border-radius: 50%; background: transparent; color: var(--c-text); cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .menu-btn:active { background: rgb(255 255 255 / 0.1); }
    .burger { position: relative; display: block; width: 20px; height: 12px; }
    .burger i { position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor; }
    .burger i:first-child { top: 0; }
    .burger i:last-child { bottom: 0; width: 70%; left: auto; }
  }
</style>
