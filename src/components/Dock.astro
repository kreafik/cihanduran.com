---
// Masaüstü dock'u (≥ 900px): buzlu cam raf, imlece göre büyüyen ikonlar (macOS büyütmesi),
// oklu etiket balonu, tıklamada zıplama ve açık sayfanın altında "çalışıyor" noktası.
import { t } from '../i18n';
import { mainNav, dockExtras, isActive } from '../lib/nav';
import AppIcon from './AppIcon.astro';

interface Props { path: string }
const { path } = Astro.props;
const groups = [
  [
    { key: 'nav.home' as const, href: '/', app: 'home' as const },
    { key: 'dock.terminal' as const, href: '/#terminal', app: 'terminal' as const },
    ...mainNav,
  ],
  dockExtras,
];
---
<nav class="dock" aria-label="Dock" data-dock>
  {groups.map((items, gi) => (
    <>
      {gi > 0 && <span class="dock-sep" aria-hidden="true" />}
      <ul>
        {items.map((item) => {
          const active = item.href === '/' ? path === '/' : item.href.startsWith('/#') ? false : isActive(path, item.href);
          return (
            <li>
              <a href={item.href} aria-current={active ? 'page' : undefined} data-dock-item>
                <span class="tip" aria-hidden="true">{t(item.key)}</span>
                <span class="icon"><AppIcon app={item.app} size={48} eager /></span>
                <span class="visually-hidden">{t(item.key)}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </>
  ))}
</nav>

<script>
  // macOS büyütmesi: imlece yakın ikonlar kosinüs eğrisiyle büyür; komşular yana açılır.
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (dock) {
    const items = [...dock.querySelectorAll<HTMLElement>('[data-dock-item]')];
    const BASE = 48, MAX = 1.6, RANGE = 150;
    let frame = 0;
    const set = (x: number | null) => {
      for (const el of items) {
        let s = 1;
        if (x !== null) {
          const r = el.getBoundingClientRect();
          const d = Math.abs(x - (r.left + r.width / 2));
          if (d < RANGE) s = 1 + (MAX - 1) * (Math.cos((d / RANGE) * Math.PI) + 1) / 2;
        }
        el.style.setProperty('--size', `${(BASE * s).toFixed(2)}px`);
      }
    };
    dock.addEventListener('mousemove', (e) => {
      if (reduce.matches) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => set(e.clientX));
    });
    dock.addEventListener('mouseleave', () => { cancelAnimationFrame(frame); set(null); });
    // Tıklamada zıplama (gezinme gecikmez; animasyon yeni sayfa yüklenene kadar görünür).
    for (const el of items) {
      el.addEventListener('click', () => {
        if (reduce.matches) return;
        el.classList.remove('bounce');
        void el.offsetWidth;
        el.classList.add('bounce');
      });
    }
  }
</script>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    z-index: 90;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 68px;
    padding: 0 8px 6px;
  }
  /* Raf: ikonlar büyüdüğünde yükselmez, yalnız ikonlar taşar (gerçek dock gibi). */
  .dock::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 20px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.07));
    background-color: rgb(40 40 44 / 0.42);
    backdrop-filter: saturate(180%) blur(28px);
    -webkit-backdrop-filter: saturate(180%) blur(28px);
    box-shadow:
      inset 0 0 0 0.5px rgb(255 255 255 / 0.28),
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 0 0 0.5px rgb(0 0 0 / 0.55),
      0 12px 32px rgb(0 0 0 / 0.42);
  }
  ul { display: flex; align-items: flex-end; gap: 2px; list-style: none; padding: 0; margin: 0; }
  li { display: flex; align-items: flex-end; }

  a {
    --size: 48px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: calc(var(--size) + 6px);
    padding-bottom: 4px;
    text-decoration: none;
    transition: width 0.12s ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .icon {
    display: block;
    width: var(--size);
    height: var(--size);
    transition: width 0.12s ease-out, height 0.12s ease-out;
  }
  .icon :global(.app-icon) { width: 100%; height: 100%; }
  a:focus-visible { outline: none; }
  a:focus-visible .icon { outline: 2px solid var(--c-accent); outline-offset: 3px; border-radius: 24%; }

  /* Açık sayfa noktası */
  a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: rgb(245 245 247 / 0.9);
    box-shadow: 0 0 4px rgb(255 255 255 / 0.5);
  }

  /* Etiket balonu (macOS: koyu cam, aşağı bakan ok) */
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 12px);
    transform: translateX(-50%);
    padding: 0.3rem 0.7rem;
    border-radius: 7px;
    background: rgb(30 30 32 / 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.18), 0 4px 14px rgb(0 0 0 / 0.4);
    color: var(--c-text);
    font-size: 0.8125rem;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.1s ease;
  }
  .tip::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    margin-left: -6px;
    border: 6px solid transparent;
    border-top-color: rgb(30 30 32 / 0.88);
  }
  a:hover .tip, a:focus-visible .tip { opacity: 1; }

  .dock-sep {
    width: 1px;
    height: 46px;
    margin: 0 6px 8px;
    background: rgb(255 255 255 / 0.22);
    box-shadow: 1px 0 0 rgb(0 0 0 / 0.25);
  }

  a.bounce .icon { animation: dock-bounce 0.9s cubic-bezier(0.3, 0, 0.3, 1); }
  @keyframes dock-bounce {
    0%, 100% { transform: translateY(0); }
    25% { transform: translateY(-22px); }
    50% { transform: translateY(0); }
    70% { transform: translateY(-9px); }
    85% { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    a, .icon { transition: none; }
  }
  @media (max-width: 899px) { .dock { display: none; } }
</style>
