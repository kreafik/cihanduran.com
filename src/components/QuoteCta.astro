---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../site.config.mjs';
import { t } from '../i18n';

interface Props { title: string; text?: string; message: string }
const { title, text = 'WhatsApp\'tan yazın ya da arayın; 24 saat içinde dönüş yapıyorum.', message } = Astro.props;
---
<section class="quote container" aria-labelledby="teklif-baslik">
  <h2 id="teklif-baslik">{title}</h2>
  <p>{text}</p>
  <div class="quote-actions">
    <a class="btn btn-whatsapp" href={whatsappLink(message)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('cta.whatsapp')}</a>
    <a class="btn btn-ghost" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
  </div>
</section>

<style>
  .quote { padding-block: var(--space-section) 0; }
  h2 { font-size: var(--fs-xl); max-width: 20ch; }
  p { margin-top: 0.9rem; color: var(--c-muted); font-size: var(--fs-md); max-width: 46ch; }
  .quote-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
</style>
